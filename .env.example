# Copy to .env.production (or .env.local) and fill in before the launch build.

# The live site's address, with no trailing slash. Used for canonical links,
# structured data, robots.txt and sitemap.xml. Leave empty until the domain is
# confirmed; the site then uses whatever address it is viewed on, and the build
# skips sitemap.xml.
VITE_SITE_URL=

# Mailing-list and form endpoints. Forms never report success without one.
VITE_NEWSLETTER_ENDPOINT=
VITE_SAMPLE_CHAPTER_ENDPOINT=
VITE_GUEST_REQUEST_ENDPOINT=
